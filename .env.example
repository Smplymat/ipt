# Knead to Know - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env or any file with real secrets!

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Configuration (already in src/app/config/supabase.config.ts)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://vbrbtajunsewqysqpfck.supabase.co
SUPABASE_ANON_KEY=sb_publishable_1389AZvIrMi9rOP8d5mXAQ_3PLOY1B8

# ─────────────────────────────────────────────────────────────────────────────
# PayMongo Configuration (REQUIRED for online payments)
# ─────────────────────────────────────────────────────────────────────────────
# SECRET KEY - NEVER put this in frontend code!
# Set this as a Supabase secret:
#   supabase secrets set PAYMONGO_SECRET_KEY=sk_test_xxxxx
# For production:
#   supabase secrets set PAYMONGO_SECRET_KEY=sk_live_xxxxx
PAYMONGO_SECRET_KEY=sk_test_xxxxx

# WEBHOOK SECRET - Set this as a Supabase secret:
#   supabase secrets set PAYMONGO_WEBHOOK_SECRET=whsk_xxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxx

# PUBLIC KEY - Only needed if you use PayMongo.js directly in frontend
# Put in src/environments/environment.ts:
#   paymongoPublicKey: 'pk_test_xxxxx'
PAYMONGO_PUBLIC_KEY=pk_test_xxxxx

# ─────────────────────────────────────────────────────────────────────────────
# App URL (for PayMongo success/cancel redirects)
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
APP_URL=http://localhost:4200
# For production:
# APP_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps (optional - for address autocomplete in checkout)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Service Role Key (for edge functions that need admin access)
# ─────────────────────────────────────────────────────────────────────────────
# NEVER put this in frontend code!
# Set this as a Supabase secret (it's already available in edge functions as SUPABASE_SERVICE_ROLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key